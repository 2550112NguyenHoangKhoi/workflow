# Dev-only fallback: in the app, users enter their Drive API key in Settings → Google Drive.
VITE_GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Google sign-in / Drive (optional; users can also enter these in Settings → Tài khoản Google).
# Browser/dev build: an OAuth client of type "Web application" (add http://localhost:5173 as an origin).
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Desktop app: an OAuth client of type "Desktop app" (the secret is entered in Settings, never bundled).
VITE_GOOGLE_DESKTOP_CLIENT_ID=
